---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteUrl = 'https://pension-alimentaire-calcul.fr';
const fullCanonical = canonical ? `${siteUrl}${canonical}` : siteUrl;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Mottalib Radif" />
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Pension Alimentaire Calcul",
      "url": "https://pension-alimentaire-calcul.fr",
      "logo": "https://pension-alimentaire-calcul.fr/favicon.svg",
      "founder": {
        "@type": "Person",
        "name": "Mottalib Radif"
      }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Mottalib Radif",
      "jobTitle": "Financial Technology Expert",
      "url": "https://pension-alimentaire-calcul.fr"
    })} />

    <!-- Plausible Analytics -->
    <script defer data-domain="pension-alimentaire-calcul.fr" src="https://plausible.io/js/script.js"></script>

    <!-- TODO: Replace G-XXXXXXXXXX with your real GA4 Measurement ID from https://analytics.google.com -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-blue-700 focus:rounded-lg focus:shadow-lg focus:ring-2 focus:ring-blue-500">Skip to content</a>
    <header class="bg-primary-700 text-white shadow-lg relative">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-white hover:text-primary-200 no-underline">
          Pension Alimentaire Calcul
        </a>

        <!-- Desktop nav -->
        <div class="hidden md:flex flex-wrap gap-4 text-sm">
          <a href="/" class="text-primary-100 hover:text-white no-underline">Calculateur</a>
          <a href="/guide-prestation/" class="text-primary-100 hover:text-white no-underline">Prestation compensatoire</a>
          <a href="/faq/" class="text-primary-100 hover:text-white no-underline">FAQ</a>
          <a href="/guides/" class="text-primary-100 hover:text-white no-underline">Guides</a>
        </div>

        <!-- Mobile hamburger button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-primary-100 hover:text-white hover:bg-primary-600 focus:outline-none focus:ring-2 focus:ring-white"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Ouvrir le menu de navigation"
        >
          <!-- Hamburger icon -->
          <svg id="hamburger-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <!-- Close icon (hidden by default) -->
          <svg id="close-icon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </nav>

      <!-- Mobile menu (hidden by default) -->
      <div id="mobile-menu" class="hidden md:hidden bg-primary-800 border-t border-primary-600">
        <div class="px-4 py-4 space-y-3">
          <a href="/" class="block text-primary-100 hover:text-white no-underline text-base py-1">Calculateur</a>
          <a href="/guide-prestation/" class="block text-primary-100 hover:text-white no-underline text-base py-1">Prestation compensatoire</a>
          <a href="/faq/" class="block text-primary-100 hover:text-white no-underline text-base py-1">FAQ</a>
          <a href="/guides/" class="block text-primary-100 hover:text-white no-underline text-base py-1">Guides</a>
        </div>
      </div>
    </header>

    <script is:inline>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');
      if (btn && menu && hamburgerIcon && closeIcon) {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          menu.classList.toggle('hidden');
          hamburgerIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        });
      }
    </script>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="bg-gray-800 text-gray-300 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h4 class="font-bold text-white mb-3">Pension Alimentaire Calcul</h4>
            <p class="text-sm">
              Calculateur indicatif basé sur la table de référence du Ministère de la Justice.
              Ce site ne fournit pas de conseil juridique.
            </p>
          </div>
          <div>
            <h4 class="font-bold text-white mb-3">Pages</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/" class="text-gray-300 hover:text-white no-underline">Accueil & Calculateur</a></li>
              <li><a href="/guide-prestation/" class="text-gray-300 hover:text-white no-underline">Guide prestation compensatoire</a></li>
              <li><a href="/faq/" class="text-gray-300 hover:text-white no-underline">Questions fréquentes</a></li>
              <li><a href="/guides/" class="text-gray-300 hover:text-white no-underline">Tous les guides</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-bold text-white mb-3">Informations légales</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/mentions-legales/" class="text-gray-300 hover:text-white no-underline">Mentions légales</a></li>
              <li><a href="/confidentialite/" class="text-gray-300 hover:text-white no-underline">Politique de confidentialité</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-700 mt-8 pt-6 text-center text-xs text-gray-500">
          &copy; {new Date().getFullYear()} pension-alimentaire-calcul.fr — Outil indicatif, ne se substitue pas à un conseil juridique.
        </div>
      </div>
    </footer>
  </body>
</html>
