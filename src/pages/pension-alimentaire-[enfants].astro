---
import Layout from '../layouts/Layout.astro';
import PensionCalculator from '../components/PensionCalculator';
import { ENFANTS_DATA, type EnfantPageData } from '../lib/enfants-data';
import '../styles/global.css';

export function getStaticPaths() {
  return ENFANTS_DATA.map((entry) => ({
    params: { enfants: entry.slug },
    props: { data: entry },
  }));
}

interface Props {
  data: EnfantPageData;
}

const { data } = Astro.props;
const { nombre, slug, label, labelLong, conseil, contenuSeo, faq, exemples } = data;

const title = `Pension alimentaire pour ${label} - Calcul 2026`;
const description = `Calculez la pension alimentaire pour ${label} avec le barème 2026 du Ministère de la Justice. Tableaux comparatifs par type de DVH et niveaux de revenus.`;
const canonical = `/pension-alimentaire-${slug}/`;
const siteUrl = 'https://pension-alimentaire-calcul.fr';

// Group exemples by revenu for the comparison table
const revenus = [2000, 3000, 4000];
const dvhTypes = [
  { key: 'dvh_reduit', label: 'DVH réduit' },
  { key: 'dvh_classique', label: 'DVH classique' },
  { key: 'dvh_elargi', label: 'DVH élargi' },
  { key: 'garde_alternee', label: 'Garde alternée' },
];

function getExemple(revenu: number, dvhKey: string) {
  return exemples.find((e) => e.revenu === revenu && e.typeDVH === dvhKey);
}

function formatEuro(n: number): string {
  return new Intl.NumberFormat('fr-FR', {
    style: 'currency',
    currency: 'EUR',
    minimumFractionDigits: 0,
    maximumFractionDigits: 2,
  }).format(n);
}

// Other children pages for cross-links
const otherChildren = ENFANTS_DATA.filter((e) => e.nombre !== nombre);

// Schema.org structured data
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Accueil',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: `Pension alimentaire ${label}`,
      item: `${siteUrl}${canonical}`,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.reponse,
    },
  })),
};
---

<Layout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumb -->
  <nav class="max-w-6xl mx-auto px-4 py-4 text-sm text-gray-500" aria-label="Fil d'Ariane">
    <ol class="flex items-center gap-2 flex-wrap">
      <li><a href="/" class="hover:text-primary-700">Accueil</a></li>
      <li class="text-gray-300">/</li>
      <li class="text-gray-700 font-medium">Pension alimentaire {label}</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="bg-primary-700 text-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-4 leading-tight">
        Pension alimentaire pour {label} - Calcul 2026
      </h1>
      <p class="text-lg text-primary-100 max-w-2xl mx-auto">
        Estimez le montant de la pension alimentaire pour {labelLong} selon le barème indicatif
        du Ministère de la Justice. Comparez les montants selon votre type de DVH et votre revenu.
      </p>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2 text-center">
      Tableau comparatif - {label}
    </h2>
    <p class="text-gray-600 text-center mb-8 max-w-2xl mx-auto">
      Montants mensuels indicatifs pour {labelLong} selon le type de DVH et le revenu net du débiteur (barème 2026, minimum vital de 635 € déduit).
    </p>

    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="bg-primary-700 text-white">
            <th class="px-4 py-3 text-left font-bold border border-primary-600">Revenu net mensuel</th>
            {dvhTypes.map((dvh) => (
              <th class="px-4 py-3 text-center font-bold border border-primary-600">{dvh.label}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {revenus.map((revenu, idx) => (
            <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
              <td class="px-4 py-3 font-semibold border border-gray-200 text-gray-900">
                {formatEuro(revenu)}
              </td>
              {dvhTypes.map((dvh) => {
                const ex = getExemple(revenu, dvh.key);
                return (
                  <td class="px-4 py-3 text-center border border-gray-200">
                    {ex ? (
                      <div>
                        <span class="font-bold text-primary-700">{formatEuro(ex.montantTotal)}</span>
                        {nombre > 1 && (
                          <span class="block text-xs text-gray-500">({formatEuro(ex.montantParEnfant)} / enfant)</span>
                        )}
                      </div>
                    ) : (
                      '-'
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="text-xs text-gray-500 mt-4 italic text-center">
      Ces montants sont purement indicatifs et basés sur le barème du Ministère de la Justice. Le montant définitif est fixé par le juge aux affaires familiales.
    </p>
  </section>

  <!-- Calculator -->
  <section class="max-w-4xl mx-auto px-4 pb-12">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 text-center">
      Calculez votre pension pour {labelLong}
    </h2>
    <PensionCalculator client:idle />
  </section>

  <!-- Contextual Advice -->
  <section class="bg-primary-50 border-t border-b border-primary-100">
    <div class="max-w-4xl mx-auto px-4 py-10">
      <div class="bg-white rounded-xl p-6 shadow-sm border border-primary-200">
        <h3 class="text-lg font-bold text-primary-900 mb-3">
          Conseil pour {label}
        </h3>
        <p class="text-gray-700">{conseil}</p>
      </div>
    </div>
  </section>

  <!-- SEO Content -->
  <article class="max-w-4xl mx-auto px-4 py-12 prose prose-lg prose-gray max-w-none">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">
      Tout savoir sur la pension alimentaire pour {labelLong}
    </h2>
    <Fragment set:html={contenuSeo.replace(/\n\n/g, '</p><p class="mb-4">').replace(/### (.*)/g, '<h3 class="text-xl font-bold text-gray-900 mt-8 mb-4">$1</h3>').replace(/- \*\*(.*?)\*\*/g, '<li><strong>$1</strong>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
  </article>

  <!-- FAQ Section -->
  <section class="bg-gray-50 border-t border-gray-200">
    <div class="max-w-4xl mx-auto px-4 py-12">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8 text-center">
        Questions fréquentes - Pension pour {label}
      </h2>
      <div class="space-y-6">
        {faq.map((item) => (
          <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200">
            <h3 class="font-bold text-gray-900 mb-3">{item.question}</h3>
            <p class="text-gray-700">{item.reponse}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-Links: Other Children Pages -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
      Calculer pour un autre nombre d'enfants
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {otherChildren.map((child) => (
        <a
          href={`/pension-alimentaire-${child.slug}/`}
          class="block bg-white rounded-xl p-4 shadow-sm border border-gray-200 hover:border-primary-400 hover:shadow-md transition-all text-center no-underline"
        >
          <span class="block text-3xl font-extrabold text-primary-700 mb-1">{child.nombre}</span>
          <span class="block text-sm text-gray-600">{child.nombre === 1 ? 'enfant' : 'enfants'}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Cross-Links: DVH Pages -->
  <section class="bg-gray-50 border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-4 py-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
        Découvrez les types de DVH
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/pension-alimentaire-dvh-reduit/" class="block bg-white rounded-xl p-5 shadow-sm border border-gray-200 hover:border-primary-400 hover:shadow-md transition-all no-underline">
          <h3 class="font-bold text-primary-700 mb-1">DVH réduit</h3>
          <p class="text-sm text-gray-600">Taux de 18 % par enfant</p>
        </a>
        <a href="/pension-alimentaire-dvh-classique/" class="block bg-white rounded-xl p-5 shadow-sm border border-gray-200 hover:border-primary-400 hover:shadow-md transition-all no-underline">
          <h3 class="font-bold text-primary-700 mb-1">DVH classique</h3>
          <p class="text-sm text-gray-600">Taux de 13,5 % par enfant</p>
        </a>
        <a href="/pension-alimentaire-dvh-elargi/" class="block bg-white rounded-xl p-5 shadow-sm border border-gray-200 hover:border-primary-400 hover:shadow-md transition-all no-underline">
          <h3 class="font-bold text-primary-700 mb-1">DVH élargi</h3>
          <p class="text-sm text-gray-600">Taux de 11,5 % par enfant</p>
        </a>
        <a href="/pension-alimentaire-garde-alternee/" class="block bg-white rounded-xl p-5 shadow-sm border border-gray-200 hover:border-primary-400 hover:shadow-md transition-all no-underline">
          <h3 class="font-bold text-primary-700 mb-1">Garde alternée</h3>
          <p class="text-sm text-gray-600">Taux de 9 % par enfant</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Guides Links -->
  <section class="max-w-4xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
      Guides et ressources
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a href="/guide-prestation/" class="block bg-white rounded-xl p-5 shadow-sm border border-gray-200 hover:border-primary-400 hover:shadow-md transition-all no-underline">
        <h3 class="font-bold text-primary-700 mb-1">Guide prestation compensatoire</h3>
        <p class="text-sm text-gray-600">Estimation du capital ou de la rente</p>
      </a>
      <a href="/faq/" class="block bg-white rounded-xl p-5 shadow-sm border border-gray-200 hover:border-primary-400 hover:shadow-md transition-all no-underline">
        <h3 class="font-bold text-primary-700 mb-1">Questions fréquentes</h3>
        <p class="text-sm text-gray-600">Réponses aux questions courantes</p>
      </a>
      <a href="/" class="block bg-white rounded-xl p-5 shadow-sm border border-gray-200 hover:border-primary-400 hover:shadow-md transition-all no-underline">
        <h3 class="font-bold text-primary-700 mb-1">Calculateur complet</h3>
        <p class="text-sm text-gray-600">Pension + prestation compensatoire</p>
      </a>
    </div>
  </section>

  <!-- Sources -->
  <section class="bg-gray-800 text-gray-300">
    <div class="max-w-4xl mx-auto px-4 py-10">
      <h2 class="text-lg font-bold text-white mb-4">Sources et références</h2>
      <ul class="space-y-2 text-sm">
        <li>Table de référence indicative du Ministère de la Justice - Barème 2026</li>
        <li>Articles 371-2 et 373-2-2 du Code civil</li>
        <li>Article 227-3 du Code pénal (abandon de famille)</li>
        <li>Service public - Pension alimentaire : <a href="https://www.service-public.fr/particuliers/vosdroits/F991" class="text-primary-300 hover:text-primary-200 underline" target="_blank" rel="noopener">service-public.fr</a></li>
        <li>CAF - Allocation de soutien familial (ASF) et ARIPA</li>
      </ul>
    </div>
  </section>
</Layout>
