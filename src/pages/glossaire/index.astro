---
import Layout from '../../layouts/Layout.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://pension-alimentaire-calcul.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Glossaire", "item": "https://pension-alimentaire-calcul.fr/glossaire/" }
  ]
};

const terms = [
  {
    term: "Bareme indicatif",
    definition: "Le bareme indicatif, ou table de reference, est la grille publiee par le Ministere de la Justice qui sert de guide aux juges pour fixer le montant de la pension alimentaire. Il croise les revenus du debiteur avec le nombre d'enfants et le mode de garde pour proposer un montant de reference."
  },
  {
    term: "Droit de visite et d'hebergement",
    definition: "Le droit de visite et d'hebergement est le droit accorde au parent qui n'a pas la residence habituelle de l'enfant de le recevoir a son domicile. La formule classique prevoit un week-end sur deux et la moitie des vacances scolaires, mais d'autres amenagements sont possibles."
  },
  {
    term: "Garde alternee",
    definition: "La garde alternee (ou residence alternee) est un mode d'organisation dans lequel l'enfant reside alternativement chez chacun de ses parents, generalement une semaine sur deux. La pension alimentaire peut etre reduite, voire supprimee, si les revenus des deux parents sont equivalents."
  },
  {
    term: "Indexation",
    definition: "L'indexation est le mecanisme qui permet de revaloriser automatiquement le montant de la pension alimentaire chaque annee en fonction de l'evolution d'un indice de reference, generalement l'indice des prix a la consommation publie par l'INSEE."
  },
  {
    term: "JAF (Juge aux Affaires Familiales)",
    definition: "Le JAF est le magistrat competent pour statuer sur les questions relatives a la famille : fixation de la pension alimentaire, residence des enfants, droit de visite et prestation compensatoire. Il peut etre saisi par requete ou par assignation."
  },
  {
    term: "Mediation familiale",
    definition: "La mediation familiale est un processus amiable et confidentiel dans lequel un mediateur agree aide les parents a trouver un accord sur les questions liees a la separation, y compris le montant de la pension alimentaire. Elle est encouragee par le juge avant toute procedure contentieuse."
  },
  {
    term: "Minimum vital",
    definition: "Le minimum vital est le montant en dessous duquel les revenus du parent debiteur ne peuvent pas descendre apres le versement de la pension alimentaire. Il correspond generalement au montant du RSA pour une personne seule, soit environ 635 euros par mois en 2026."
  },
  {
    term: "Obligation alimentaire",
    definition: "L'obligation alimentaire est le devoir legal impose par le Code civil aux parents de contribuer a l'entretien et a l'education de leurs enfants a proportion de leurs ressources. Cette obligation persiste meme apres la majorite de l'enfant s'il poursuit ses etudes."
  },
  {
    term: "Part contributive",
    definition: "La part contributive designe la contribution financiere de chaque parent a l'entretien de l'enfant. Elle est fixee en proportion des revenus de chacun et tient compte du mode de garde. La pension alimentaire represente la part contributive du parent qui n'a pas la residence principale de l'enfant."
  },
  {
    term: "Pension alimentaire",
    definition: "La pension alimentaire est une somme d'argent versee par un parent a l'autre pour contribuer a l'entretien et a l'education des enfants apres une separation ou un divorce. Son montant est fixe par le juge aux affaires familiales ou par accord entre les parents."
  },
  {
    term: "Prestation compensatoire",
    definition: "La prestation compensatoire est une indemnite versee par l'un des epoux a l'autre lors du divorce pour compenser la disparite de niveau de vie creee par la rupture du mariage. Elle est distincte de la pension alimentaire pour les enfants et peut etre versee en capital ou sous forme de rente."
  },
  {
    term: "Residence habituelle",
    definition: "La residence habituelle designe le domicile principal de l'enfant, fixe par le juge ou par accord entre les parents. Le parent chez lequel l'enfant a sa residence habituelle est dit 'parent gardien' et recoit la pension alimentaire de l'autre parent."
  },
  {
    term: "Revalorisation",
    definition: "La revalorisation de la pension alimentaire est l'ajustement de son montant pour tenir compte de l'evolution du cout de la vie ou d'un changement de situation. Elle peut etre automatique (indexation) ou demandee au juge en cas de modification substantielle des revenus ou des besoins."
  },
  {
    term: "Revenus du debiteur",
    definition: "Les revenus du debiteur sont l'ensemble des ressources du parent qui doit verser la pension alimentaire. Ils comprennent les salaires, les revenus d'activite independante, les revenus fonciers, les allocations et les avantages en nature. Le minimum vital est deduit avant le calcul."
  },
  {
    term: "Titre executoire",
    definition: "Le titre executoire est un document officiel (jugement, ordonnance, convention homologuee) qui permet de recourir a l'execution forcee en cas de non-paiement de la pension alimentaire. Il autorise le recours a un huissier ou au mecanisme de paiement direct."
  }
];
---
<Layout title="Glossaire de la pension alimentaire - Pension Alimentaire Calcul" description="Definitions des termes cles de la pension alimentaire : bareme, JAF, garde alternee, indexation, prestation compensatoire et plus encore.">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-8">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-gray-700">Accueil</a></li>
        <li>/</li>
        <li class="text-gray-800 font-medium">Glossaire</li>
      </ol>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-4">Glossaire de la pension alimentaire</h1>
    <p class="text-gray-600 mb-8">Retrouvez les definitions des termes essentiels relatifs a la pension alimentaire et au droit de la famille en France. Ce glossaire vous aide a comprendre les notions juridiques et financieres liees a la contribution parentale.</p>

    <div class="space-y-6">
      {terms.map((item) => (
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
          <h2 class="text-lg font-semibold text-purple-700 mb-2">{item.term}</h2>
          <p class="text-gray-600">{item.definition}</p>
        </div>
      ))}
    </div>
  </div>
</Layout>
