---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';

const guides = [
  {
    title: "Barème pension alimentaire 2026",
    description: "Table de référence officielle du Ministère de la Justice : taux par DVH, méthode de calcul et exemples chiffrés.",
    href: "/guides/bareme-pension-alimentaire/",
    icon: "📊",
  },
  {
    title: "DVH classique vs élargi",
    description: "Comprendre les quatre types de droit de visite et d'hébergement : réduit, classique, élargi et garde alternée.",
    href: "/guides/dvh-classique-vs-elargi/",
    icon: "📅",
  },
  {
    title: "Pension alimentaire en garde alternée",
    description: "Quand une pension est-elle due en résidence alternée ? Calcul, conditions et jurisprudence.",
    href: "/guides/pension-alimentaire-garde-alternee/",
    icon: "⚖️",
  },
  {
    title: "Révision de la pension alimentaire",
    description: "Comment modifier le montant de la pension : conditions, procédure devant le JAF et délais.",
    href: "/guides/revision-pension-alimentaire/",
    icon: "🔄",
  },
  {
    title: "Non-paiement de la pension alimentaire",
    description: "Que faire en cas d'impayé ? Recours : huissier, CAF, Trésor public et sanctions pénales.",
    href: "/guides/non-paiement-pension-alimentaire/",
    icon: "🚨",
  },
  {
    title: "Pension alimentaire pour enfant majeur",
    description: "L'obligation alimentaire au-delà de 18 ans : conditions, limites et traitement fiscal.",
    href: "/guides/pension-enfant-majeur/",
    icon: "🎓",
  },
  {
    title: "Fiscalité de la pension alimentaire",
    description: "Déduction pour le débiteur, imposition pour le créancier : tout sur le traitement fiscal en 2026.",
    href: "/guides/fiscalite-pension-alimentaire/",
    icon: "🧾",
  },
  {
    title: "Médiation familiale",
    description: "Processus, avantages, aides de la CAF et alternatives au tribunal pour régler les conflits familiaux.",
    href: "/guides/mediation-familiale/",
    icon: "🤝",
  },
];
---

<Layout
  title="Guides Pension Alimentaire 2026 - Barème, DVH, Fiscalité, Révision"
  description="Tous nos guides pratiques sur la pension alimentaire : barème officiel, DVH, garde alternée, révision, non-paiement, enfant majeur, fiscalité et médiation familiale."
  canonical="/guides/"
>
  <section class="bg-primary-700 text-white py-14">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-4">
        Guides pratiques - Pension alimentaire
      </h1>
      <p class="text-lg text-primary-100">
        Retrouvez tous nos guides détaillés pour comprendre le calcul, la révision, la fiscalité
        et les recours liés à la pension alimentaire en France.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {guides.map((guide) => (
        <a
          href={guide.href}
          class="group block bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md hover:border-primary-200 transition-all p-6 no-underline"
        >
          <div class="text-3xl mb-3">{guide.icon}</div>
          <h2 class="text-lg font-bold text-gray-900 group-hover:text-primary-700 mb-2 transition-colors">
            {guide.title}
          </h2>
          <p class="text-sm text-gray-600 leading-relaxed">
            {guide.description}
          </p>
          <span class="inline-block mt-4 text-sm font-semibold text-primary-600 group-hover:text-primary-700">
            Lire le guide &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
