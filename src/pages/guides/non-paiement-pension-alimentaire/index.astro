            <td class="border border-gray-300 px-4 py-3 text-center">Dès le 1er impayé</td>
            <td class="border border-gray-300 px-4 py-3 text-center">6 mois</td>
            <td class="border border-gray-300 px-4 py-3 text-center">À la charge du débiteur</td>
          </tr>
