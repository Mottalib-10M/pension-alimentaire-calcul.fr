            <td class="border border-gray-300 px-4 py-3 text-center">Après 2 mois d'impayé</td>
            <td class="border border-gray-300 px-4 py-3 text-center">-</td>
            <td class="border border-gray-300 px-4 py-3 text-center">Gratuit</td>
          </tr>
        </tbody>
      </table>
