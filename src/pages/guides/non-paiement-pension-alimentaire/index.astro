            <td class="border border-gray-300 px-4 py-3 text-center">24 mois</td>
            <td class="border border-gray-300 px-4 py-3 text-center">Gratuit</td>
          </tr>
          <tr>
            <td class="border border-gray-300 px-4 py-3 font-semibold">Saisie sur salaire</td>
            <td class="border border-gray-300 px-4 py-3 text-center">Dès le 1er impayé</td>
            <td class="border border-gray-300 px-4 py-3 text-center">5 ans (prescription)</td>
            <td class="border border-gray-300 px-4 py-3 text-center">Frais judiciaires</td>
          </tr>
          <tr class="bg-gray-50">
            <td class="border border-gray-300 px-4 py-3 font-semibold">Trésor public</td>
            <td class="border border-gray-300 px-4 py-3 text-center">Après échec autres voies</td>
            <td class="border border-gray-300 px-4 py-3 text-center">6 mois min.</td>
            <td class="border border-gray-300 px-4 py-3 text-center">À la charge du débiteur</td>
          </tr>
          <tr>
