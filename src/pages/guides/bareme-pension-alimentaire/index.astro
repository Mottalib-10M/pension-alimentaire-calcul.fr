            <td class="border border-gray-300 px-4 py-3 text-center">10,0 %</td>
            <td class="border border-gray-300 px-4 py-3 text-center">8,8 %</td>
            <td class="border border-gray-300 px-4 py-3 text-center">8,0 %</td>
            <td class="border border-gray-300 px-4 py-3 text-center">7,2 %</td>
          </tr>
