<Layout
  title="Barème Pension Alimentaire 2026 - Table de Référence Officielle du Ministère"
  description="Guide complet sur le barème officiel de la pension alimentaire 2026 : table de référence du Ministère de la Justice, taux par DVH, exemples de calcul chiffrés."
  canonical="/guides/bareme-pension-alimentaire/"
>
  <!-- Breadcrumb -->
  <nav class="max-w-4xl mx-auto px-4 py-4 text-sm text-gray-500">
    <ol class="flex flex-wrap items-center gap-1">
      <li><a href="/" class="hover:text-primary-700 no-underline">Accueil</a></li>
      <li class="before:content-['/'] before:mx-2"><a href="/guides/" class="hover:text-primary-700 no-underline">Guides</a></li>
